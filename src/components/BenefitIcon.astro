---
interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

{icon === 'leaf' && (
  <svg class="benef-icon" viewBox="0 0 40 40" fill="none">
    <path d="M20 4C11 4 6 14 6 22c0 8 6 14 14 14s14-6 14-14C34 14 29 4 20 4Z" stroke="currentColor" stroke-width="2"/>
    <path d="M20 4c-3 5-3 9 0 14" stroke="currentColor" stroke-width="2"/>
  </svg>
)}
{icon === 'grid' && (
  <svg class="benef-icon" viewBox="0 0 40 40" fill="none">
    <path d="M8 16h24M8 24h24M14 8v24M26 8v24" stroke="currentColor" stroke-width="2"/>
  </svg>
)}
{icon === 'clock' && (
  <svg class="benef-icon" viewBox="0 0 40 40" fill="none">
    <circle cx="20" cy="20" r="15" stroke="currentColor" stroke-width="2"/>
    <path d="M20 12v8l6 4" stroke="currentColor" stroke-width="2"/>
  </svg>
)}
{icon === 'star' && (
  <svg class="benef-icon" viewBox="0 0 40 40" fill="none">
    <path d="M6 20h28M20 6v28M11 11l18 18M29 11 11 29" stroke="currentColor" stroke-width="2"/>
  </svg>
)}
