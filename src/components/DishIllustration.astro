---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

{id === 'ceviche-clasico' && (
  <svg viewBox="0 0 200 140">
    <ellipse cx="100" cy="110" rx="90" ry="18" fill="#e4c6b6"/>
    <ellipse cx="100" cy="70" rx="85" ry="40" fill="#F8F4EC" stroke="#D4A017" stroke-width="3"/>
    <g fill="#9E1B32"><rect x="55" y="55" width="18" height="10" rx="2"/><rect x="90" y="60" width="18" height="10" rx="2"/><rect x="125" y="52" width="18" height="10" rx="2"/></g>
    <g fill="#6C7A3D"><circle cx="70" cy="78" r="6"/><circle cx="115" cy="80" r="6"/></g>
  </svg>
)}
{id === 'lomo-saltado' && (
  <svg viewBox="0 0 200 140">
    <ellipse cx="100" cy="112" rx="88" ry="16" fill="#d8c79f"/>
    <rect x="35" y="55" width="130" height="45" rx="10" fill="#9E1B32"/>
    <g fill="#D4A017"><rect x="45" y="62" width="20" height="8" rx="2"/><rect x="80" y="68" width="20" height="8" rx="2"/><rect x="115" y="60" width="20" height="8" rx="2"/><rect x="140" y="72" width="14" height="8" rx="2"/></g>
  </svg>
)}
{id === 'causa-limena' && (
  <svg viewBox="0 0 200 140">
    <ellipse cx="100" cy="112" rx="88" ry="16" fill="#cfd0ab"/>
    <rect x="55" y="45" width="90" height="55" rx="8" fill="#D4A017"/>
    <rect x="55" y="45" width="90" height="14" fill="#6C7A3D"/>
    <circle cx="75" cy="80" r="6" fill="#9E1B32"/>
    <circle cx="100" cy="80" r="6" fill="#F8F4EC"/>
    <circle cx="125" cy="80" r="6" fill="#3B2A22"/>
  </svg>
)}
{id === 'anticuchos' && (
  <svg viewBox="0 0 200 140">
    <g>
      <rect x="40" y="80" width="120" height="8" rx="4" fill="#3B2A22"/>
      <rect x="45" y="60" width="18" height="24" rx="4" fill="#9E1B32"/>
      <rect x="75" y="60" width="18" height="24" rx="4" fill="#9E1B32"/>
      <rect x="105" y="60" width="18" height="24" rx="4" fill="#9E1B32"/>
      <rect x="135" y="60" width="18" height="24" rx="4" fill="#9E1B32"/>
      <line x1="54" y1="84" x2="54" y2="110" stroke="#6C7A3D" stroke-width="4"/>
      <line x1="84" y1="84" x2="84" y2="110" stroke="#6C7A3D" stroke-width="4"/>
      <line x1="114" y1="84" x2="114" y2="110" stroke="#6C7A3D" stroke-width="4"/>
      <line x1="144" y1="84" x2="144" y2="110" stroke="#6C7A3D" stroke-width="4"/>
    </g>
  </svg>
)}
{id === 'aji-de-gallina' && (
  <svg viewBox="0 0 200 140">
    <ellipse cx="100" cy="110" rx="90" ry="18" fill="#e4d19f"/>
    <ellipse cx="100" cy="72" rx="85" ry="38" fill="#D4A017"/>
    <g fill="#F8F4EC"><rect x="70" y="60" width="60" height="10" rx="4"/></g>
    <circle cx="150" cy="70" r="8" fill="#9E1B32"/>
  </svg>
)}
{id === 'chicha-morada' && (
  <svg viewBox="0 0 200 140">
    <path d="M75 40 Q100 30 125 40 L130 100 Q100 112 70 100 Z" fill="#3B2A22"/>
    <ellipse cx="100" cy="42" rx="27" ry="9" fill="#5a3f30"/>
    <rect x="93" y="10" width="14" height="30" rx="4" fill="#6C7A3D"/>
  </svg>
)}
